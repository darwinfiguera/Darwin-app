# Postgres connection used by Prisma
DATABASE_URL="postgresql://miscuentas:miscuentas@localhost:5432/miscuentas?schema=public"

# Server
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Admin bootstrap: first login with this email is auto-promoted to admin
ADMIN_EMAIL="tirolesainforma@gmail.com"

# Google Sign-In (create an OAuth client at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""

# Apple Sign-In (Services ID from https://developer.apple.com/account/resources/identifiers/list/serviceId)
APPLE_CLIENT_ID=""

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_ANNUAL=""
APP_URL="http://localhost:4000"
