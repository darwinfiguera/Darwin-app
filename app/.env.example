# URL of your self-hosted backend (see /backend). Must include the /api suffix.
# For a physical device on the same Wi-Fi as your dev machine, use your machine's LAN IP
# instead of localhost, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Optional: only needed to enable "Continuar con Google" in the app.
# Create OAuth client IDs at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
